# Copy to .env for local, non-Docker runs. The docker-compose stack sets these
# via `environment:` and does not read this file.

ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg2://snaptrack:snaptrack@localhost:5432/snaptrack
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

PHOTO_STORAGE_DIR=./_storage

JWT_SECRET_KEY=dev-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

PHOTO_CACHE_TTL_SECONDS=60
THUMBNAIL_MAX_EDGE=256
THUMBNAIL_TASK_MAX_RETRIES=3
