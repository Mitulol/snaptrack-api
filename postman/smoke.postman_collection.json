{
  "info": {
    "name": "SnapTrack API \u2014 Smoke Suite",
    "description": "Post-deploy smoke tests: auth flow, photo CRUD happy path, and 4xx cases. Chained via collection variables; run with Newman against a live stack.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "photoId",
      "value": ""
    },
    {
      "key": "modPhotoId",
      "value": ""
    },
    {
      "key": "flagId",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('email')) {",
          "  pm.collectionVariables.set('email', `smoke-${Date.now()}@example.com`);",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "auth",
      "item": [
        {
          "name": "register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"password123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test('echoes email, hides password', () => {",
                  "  pm.expect(b.email).to.eql(pm.collectionVariables.get('email'));",
                  "  pm.expect(b).to.not.have.property('hashed_password');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "register duplicate -> 409",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"password123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 Conflict', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"password123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('returns a bearer token', () => pm.expect(b.token_type).to.eql('bearer'));",
                  "pm.collectionVariables.set('token', b.access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "login wrong password -> 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"wrong-password\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('is the smoke user', () => pm.expect(pm.response.json().email).to.eql(pm.collectionVariables.get('email')));"
                ]
              }
            }
          ]
        },
        {
          "name": "me without token -> 401",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "photos",
      "item": [
        {
          "name": "upload",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/photos",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "fixtures/sample.png"
                },
                {
                  "key": "caption",
                  "value": "smoke upload",
                  "type": "text"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test('has dimensions + caption + thumbnail row', () => {",
                  "  pm.expect(b.width).to.eql(48);",
                  "  pm.expect(b.caption).to.eql('smoke upload');",
                  "  pm.expect(b.thumbnail).to.have.property('status');",
                  "});",
                  "pm.collectionVariables.set('photoId', String(b.id));"
                ]
              }
            }
          ]
        },
        {
          "name": "upload non-image -> 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/photos",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "fixtures/not-an-image.txt"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request (bytes are not a supported image)', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "get photo (cache-aside)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/photos/{{photoId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('is the uploaded photo', () => pm.expect(String(pm.response.json().id)).to.eql(pm.collectionVariables.get('photoId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "get photo unauthenticated -> 401",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/photos/{{photoId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "list photos",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/photos?limit=10&offset=0"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('paginated shape', () => {",
                  "  pm.expect(b).to.have.all.keys('items', 'total', 'limit', 'offset');",
                  "  pm.expect(b.total).to.be.at.least(1);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "patch caption",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/photos/{{photoId}}",
            "body": {
              "mode": "raw",
              "raw": "{ \"caption\": \"edited by smoke\" }"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('caption updated', () => pm.expect(pm.response.json().caption).to.eql('edited by smoke'));"
                ]
              }
            }
          ]
        },
        {
          "name": "get missing photo -> 404",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/photos/99999999"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 Not Found', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "thumbnail status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/photos/{{photoId}}/thumbnail"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('has a known status', () => pm.expect(['pending','processing','ready','failed']).to.include(pm.response.json().status));"
                ]
              }
            }
          ]
        },
        {
          "name": "delete photo",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/photos/{{photoId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204 No Content', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "get deleted photo -> 404",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/photos/{{photoId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 Not Found', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "moderation",
      "item": [
        {
          "name": "upload a photo to flag",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/photos",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "fixtures/sample.png"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('modPhotoId', String(pm.response.json().id));"
                ]
              }
            }
          ]
        },
        {
          "name": "owner flags the photo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/photos/{{modPhotoId}}/flag",
            "body": {
              "mode": "raw",
              "raw": "{ \"reason\": \"spam\", \"note\": \"smoke flag\" }"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test('flag is pending', () => pm.expect(b.status).to.eql('pending'));",
                  "pm.collectionVariables.set('flagId', String(b.id));"
                ]
              }
            }
          ]
        },
        {
          "name": "duplicate flag -> 409",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/photos/{{modPhotoId}}/flag",
            "body": {
              "mode": "raw",
              "raw": "{ \"reason\": \"other\" }"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 Conflict', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "flag without a token -> 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/photos/{{modPhotoId}}/flag",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{ \"reason\": \"spam\" }"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 without a token', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "non-admin cannot view the queue -> 403",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/moderation/queue"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403 Forbidden (RBAC)', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "non-admin cannot decide -> 403",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/moderation/{{flagId}}/decision",
            "body": {
              "mode": "raw",
              "raw": "{ \"decision\": \"dismiss\" }"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403 Forbidden (RBAC)', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "health",
      "item": [
        {
          "name": "healthz",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/healthz"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('status ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
                ]
              }
            }
          ]
        },
        {
          "name": "readyz",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/readyz"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('db + redis both ok', () => {",
                  "  pm.expect(b.checks.database).to.eql('ok');",
                  "  pm.expect(b.checks.redis).to.eql('ok');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}